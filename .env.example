# Copy this file to .env (already .gitignore'd) and fill in real values.
# Used by docker-compose.yml. See webadmin/README.md for what each variable
# means.

# --- Supabase (required: all club data, admin sign-in, calendar feed) ---
# Admins sign in with their own Blindensport Graz account and the server
# acts AS that account (anon/publishable key + their token), so Supabase RLS
# decides what they may do. Web access: coach, admin, root.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Anon / publishable key (sb_publishable_… or the legacy anon JWT).
SUPABASE_ANON_KEY=
# Service-role / sb_secret key: bypasses RLS, used ONLY by the calendar feed
# (/calendar/<token>). Server-side only — never put it in the app or commit it.
SUPABASE_SERVICE_KEY=
# Session cookie is Secure (HTTPS only) by default. Set to false ONLY for local
# testing over plain http://localhost.
# SESSION_COOKIE_SECURE=false

# --- TLS reverse proxy (Caddy service in docker-compose.yml) ---
# DOMAIN's DNS must point at this host, with ports 80+443 reachable from the
# internet, for Let's Encrypt to issue a certificate — see Caddyfile.
DOMAIN=a11y.it
ACME_EMAIL=dev@a11y.it
