# Copy this file to .env (already .gitignore'd) and fill in real values.
# Used by docker-compose.yml. See RootCLI/README.md for how to obtain the
# CloudKit S2S key pair and what each variable means.

# --- CloudKit Server-to-Server auth (required) ---
CLOUDKIT_KEY_ID=
# Host path to the PKCS8 private key file; mounted read-only into the
# container by docker-compose.yml (CLOUDKIT_PRIVATE_KEY_PATH inside the
# container is set separately in docker-compose.yml — don't set it here).
CLOUDKIT_PRIVATE_KEY_HOST_PATH=./secrets/rootcli_private_key_pkcs8.pem
CLOUDKIT_ENVIRONMENT=production
# CLOUDKIT_CONTAINER=iCloud.it.a11y.BlindensportGraz

# --- Supabase (required: admin sign-in, roles, calendar tokens, protected
# member data) ---
# Service-role / sb_secret key: bypasses RLS. Server-side only — never put it
# in the app or commit it. Admins sign in to the web admin with their own
# Blindensport Graz account; access needs the members.manage permission
# (admin/root roles).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=
# Session cookie is Secure (HTTPS only) by default. Set to false ONLY for local
# testing over plain http://localhost.
# SESSION_COOKIE_SECURE=false

# --- TLS reverse proxy (Caddy service in docker-compose.yml) ---
# DOMAIN's DNS must point at this host, with ports 80+443 reachable from the
# internet, for Let's Encrypt to issue a certificate — see Caddyfile.
DOMAIN=a11y.it
ACME_EMAIL=dev@a11y.it
